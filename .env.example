# Core
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_DESIGN_MODEL=gpt-5.6-sol
OPENAI_WORKER_MODEL=gpt-5.6-terra
OPENAI_FRONTEND_MODEL=gpt-5.6-terra
OPENAI_BACKEND_MODEL=gpt-5.6-terra
OPENAI_DATABASE_MODEL=gpt-5.6-luna
OPENAI_REPAIR_STANDARD_MODEL=gpt-5.6-terra
OPENAI_REPAIR_MODEL=gpt-5.6-sol
OPENAI_EVALUATOR_MODEL=gpt-5.6-luna
OPENAI_VISUAL_EVALUATOR_MODEL=gpt-5.6-terra
OPENAI_ARTIFACT_MODEL=gpt-5.6-luna
OPENAI_EXPLAINER_MODEL=gpt-6-luna
ENABLE_PROJECT_EXPLAINER=true
EXPLAINER_MAX_INPUT_CHARS=60000
EXPLAINER_CHAT_CONTEXT_CHARS=6000
EXPLAINER_MAX_QUESTION_CHARS=2000
EXPLAINER_MAX_OUTPUT_TOKENS=500
EXPLAINER_PROMPT_LIMIT=10
EXPLAINER_BUDGET_USD=0.01
EXPLAINER_PER_PROMPT_BUDGET_USD=0.001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_COST_PER_MINUTE_USD=0.003
NORMAL_RUN_BUDGET_USD=0.25
MAXIMUM_RUN_BUDGET_USD=1.00
DEFAULT_ADVANCED_RUN_BUDGET_USD=1.50
MAXIMUM_ADVANCED_RUN_BUDGET_USD=5.00
ENABLE_LLM_CALLS=true

# Supabase / Postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ENABLE_PERSISTENCE=false
ENABLE_LANGGRAPH_CHECKPOINTING=true
LANGGRAPH_STRICT_MSGPACK=true

# Web search / browser tools
SERPER_API_KEY=
ENABLE_WEB_SEARCH=true
ENABLE_BROWSER=false
ENABLE_MEDIA_DOWNLOADS=true
MAX_MEDIA_ASSETS=3
MAX_IMAGE_DOWNLOAD_BYTES=12000000
MAX_VIDEO_DOWNLOAD_BYTES=64000000
MAX_USER_MEDIA_ASSETS=8
MAX_USER_IMAGE_UPLOAD_BYTES=20000000
MAX_USER_VIDEO_UPLOAD_BYTES=250000000
MAX_VOICE_RECORDING_BYTES=25000000
MAX_VOICE_RECORDING_SECONDS=600
# Temporary downloads are removed automatically after success, terminal failure, or replan.
# MEDIA_CACHE_DIR=/absolute/path/to/agentic-forge/.agentic-forge/media-cache
# UPLOAD_CACHE_DIR=/absolute/path/to/agentic-forge/.agentic-forge/upload-cache

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=software-developer-agent
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=

# Redis queue
ENABLE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# Runtime limits
MAX_INPUT_TOKENS=25000
MAX_JOB_LOOPS=12
MAX_AUTOMATIC_REPLANS=1
MAX_WORKER_ATTEMPTS=4
MAX_TOTAL_ATTEMPTS=12
MAX_MANIFEST_RECOVERY_ATTEMPTS=2
MAX_LLM_CALLS_PER_NODE=6
MAX_SEARCH_RESULTS=5
MAX_BROWSER_PAGES=3
TOOL_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=180
OPENAI_TRANSPORT_RETRIES=0
ARTIFACT_VALIDATION_TIMEOUT_SECONDS=240
ARTIFACT_AUDIT_TIMEOUT_SECONDS=15
ARTIFACT_INFRASTRUCTURE_RETRY_ATTEMPTS=1
ARTIFACT_VALIDATION_MEMORY_LIMIT_MB=2048

# Local generated output
ENABLE_ARTIFACT_GENERATION=true
ENABLE_ARTIFACT_VALIDATION=true
ENABLE_DOMAIN_ADAPTER_VALIDATION=true
ENABLE_GUARANTEED_ARTIFACT_FALLBACK=true
ARTIFACT_VALIDATION_SANDBOX_MODE=docker
# Optional absolute overrides:
# ARTIFACTS_DIR=/absolute/path/to/agentic-forge/artifacts
# GENERATED_PROJECTS_DIR=/absolute/path/to/agentic-forge/generated-projects

# Isolated local preview runtime
ENABLE_LIVE_PREVIEW=true
PREVIEW_SANDBOX_MODE=docker
PREVIEW_DOCKER_NETWORK=agentic-forge-quarantine
ENABLE_AUTO_PREVIEW=true
PREVIEW_HOST=127.0.0.1
PREVIEW_PORT_START=4100
PREVIEW_PORT_END=4199
PREVIEW_STARTUP_TIMEOUT_SECONDS=30
PREVIEW_INSTALL_TIMEOUT_SECONDS=240
PREVIEW_MEMORY_LIMIT_MB=1024
PREVIEW_CPU_LIMIT_SECONDS=300
ENABLE_BROWSER_EDITOR=true
ENABLE_COLLABORATION=true

# Optional provider actions (disabled until explicitly enabled)
ENABLE_PROVIDER_ACTIONS=false
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
SUPABASE_MANAGEMENT_ACCESS_TOKEN=
SUPABASE_MANAGEMENT_API_URL=https://api.supabase.com
PROVIDER_TIMEOUT_SECONDS=60
